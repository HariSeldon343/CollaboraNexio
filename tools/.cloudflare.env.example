# =============================================================================
# CollaboraNexio — Cloudflare cache purge auth (template)
#
# Copy to tools/.cloudflare.env (untracked — see .gitignore) and fill in.
# Both purge scripts (cloudflare_purge.ps1 / .sh) auto-load this file if
# present so you don't have to set env vars in every shell.
# =============================================================================

# 1) API token. Generate at:
#    https://dash.cloudflare.com/profile/api-tokens
#    Use template "Custom Token" with permission:
#      Zone -> Cache Purge -> Purge
#    Resource: include the nexiosolution.it zone only.
#    DO NOT use the global API key — least-privilege.
CF_API_TOKEN=replace-me-with-zone-cache-purge-token

# 2) Zone ID for nexiosolution.it.
#    Found on the zone overview page in the Cloudflare dashboard,
#    right sidebar under "API".
CF_ZONE_ID=replace-me-with-zone-id
